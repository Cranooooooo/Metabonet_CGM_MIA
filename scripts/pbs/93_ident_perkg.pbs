#!/bin/bash
#PBS -N cgm_idkg
#PBS -P 11704243
#PBS -j oe
#
# How much of basal's identifiability is body size?
#
# Measured on raw IU with a within-study control, one day of basal retrieves its own
# subject 29.3% of the time against CGM's 1.5% -- about 20x. Insulin is dosed per
# kilogram, so a raw-IU basal channel carries body mass, and body mass is a stable
# personal attribute that has nothing to do with whether a regimen is distinctive. If
# most of the 20x is body size, the claim has to be restated.
#
# Two cohorts, identical except for the division, both measured with the same
# within-study retrieval. The raw one is built here so the comparison is like for like;
# it holds 1,262 subjects against the per-kg cohort's 1,208, because 54 have no recorded
# weight and cannot be divided. A 4% difference in subject set cannot account for a 20x
# effect, but it is stated rather than hidden.
#
# Which spaces CAN move, and which cannot, is fixed by the arithmetic: dividing a
# channel by a per-subject constant changes `level`, `quantile` and `raw`, and leaves
# `shape` and `acf` untouched because both already z-score each window. `shape` is
# therefore the internal control -- if it moves, something other than the division did
# it.
#
#   qsub -l select=1:ncpus=32:mem=200gb -l walltime=03:00:00 \
#        -o logs/93_ident_perkg.log scripts/pbs/93_ident_perkg.pbs             # -> q2
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
{
  echo "########## 1. the same two channels, WITHOUT the division ##########"
  python -u scripts/build_cohort_multi.py --subject-key study_id \
    --channels CGM basal --out data/cohort/metabonet_sid_c2_raw

  echo "########## 2. identifiability, raw IU, within study ##########"
  python -u scripts/identifiability.py --cohort data/cohort/metabonet_sid_c2_raw \
    --within-study --out results/identifiability_within

  echo "########## 3. identifiability, per kilogram, within study ##########"
  python -u scripts/identifiability.py --cohort data/cohort/metabonet_sid_c2_perkg \
    --within-study --out results/identifiability_within
} 2>&1 | tee logs/93_ident_perkg.live.log
