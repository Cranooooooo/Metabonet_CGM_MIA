#!/bin/bash
#PBS -N cgm_ident_s
#PBS -P 11704243
#PBS -j oe
#
# Identifiability ceiling on the cohorts rebuilt with the corrected (source_file, id)
# key: one channel and three channels, over the same subjects and the same days, so the
# difference between them is channel content and not cohort size. Submitted with
# -W depend=afterok on the rebuild.
#
#   qsub -W depend=afterok:<rebuild> -l select=1:ncpus=32:mem=96gb \
#        -l walltime=02:00:00 -o logs/56_ident_sid.log scripts/pbs/56_ident_sid.pbs
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
{
  python -u scripts/identifiability.py --cohort data/cohort/metabonet_sid_c1
  python -u scripts/identifiability.py --cohort data/cohort/metabonet_sid_c3
  python -u scripts/identifiability_vs_outliers.py \
    --per-subject results/identifiability/metabonet875_per_subject.csv \
                  results/identifiability/metabonet_sid_c1_per_subject.csv \
                  results/identifiability/metabonet_sid_c3_per_subject.csv
} 2>&1 | tee logs/56_ident_sid.live.log
