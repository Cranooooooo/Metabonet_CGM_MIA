#!/bin/bash
#PBS -N cgm_capacity_probe
#PBS -P 11704243
#PBS -j oe
#
# Resources go on the command line: the shape IS the queue selector, and which queue has
# room changes by the hour. One width per allocated card, so a 3-GPU request has all
# three working rather than reserving a band to idle it (guide section 3):
#
#   qsub -l select=1:ncpus=48:mem=120gb:ngpus=3 -l walltime=03:00:00 \
#        -o logs/06c_capacity_probe.log scripts/pbs/06c_capacity_probe.pbs      # -> g2
#
#   qsub -l select=1:ncpus=16:mem=64gb:ngpus=1 -l walltime=02:00:00 \
#        -o logs/06c_capacity_probe.log scripts/pbs/06c_capacity_probe.pbs      # -> gdev
#
# gdev is priority 100 and normally the right lane, but its 16-card pool is shared with
# the whole machine and was 15-deep on 2026-08-07 while g2 had headroom.
#
# What does WIDTH cost? 06_dimts_probe.pbs enumerated hidden_size -> parameters but
# timed only the ~500k model, so the campaign budget is known at one width and guessed
# at every other. Choosing the capacity condition without this is choosing it blind:
# hidden_size 52 -> 128 is 5.3x the parameters, and the whole question is whether that
# is 5.3x the bill or 1.3x.
#
# It is genuinely open. 522,907 parameters at batch 64 does not fill an A100 -- if the
# step is latency-bound rather than FLOP-bound, most of the extra width is free. That
# is measurable in minutes and worth ~400 GPU-hours of budget, so it is measured.
#
# Same protocol as 06 (random data of the right shape; step time depends on batch_size,
# T, C and hidden_size, not on how many windows the training set holds), and the same
# two-point discipline is unnecessary here because per_step is timed directly after a
# warm-up rather than inferred from a total.

source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"

DIMTS_ENV=$WORK/envs/dimts
test -d "$DIMTS_ENV" || { echo "run 05_dimts_env.pbs first"; exit 1; }
module load cuda/11.8.0
conda activate "$DIMTS_ENV"
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$REPO/vendor/DiM-TS/Models/interpretable_diffusion:$REPO/vendor/DiM-TS:${PYTHONPATH:-}"

mkdir -p "$REPO/results/probe"
cd "$REPO/vendor/DiM-TS"

read -ra ALL <<< "${WIDTHS:-52 96 128}"
# PBS hands out ABSOLUTE device ids -- GPU UUIDs on this machine, not 0..n. Writing a
# loop counter into CUDA_VISIBLE_DEVICES points a task at a card the job does not own,
# and torch then reports "CUDA not available", which reads as a bad wheel.
IFS=',' read -ra ALLOC <<< "${CUDA_VISIBLE_DEVICES:-0}"
echo "PBS allocated ${#ALLOC[@]} GPU(s) for ${#ALL[@]} width(s)"

probe_one() {                       # $1 = space-separated widths, $2 = output suffix
    WIDTHS="$1" OUT="$REPO/results/probe/capacity_$2.json" python - <<'PY'
import json, os, time
import torch
from Models.interpretable_diffusion.gaussian_diffusion import DiM_TS

T, C = 288, 1
BATCH = 64                 # configs/experiment.yaml models.params.batch_size
STEPS = 100_000            # ... models.params.steps, grad-accum 2
K = 179_522               # the base job's training-set size == released samples
SAMPLE_BATCH = 1000        # ... models.params.sample_batch


def cfg(h):
    return dict(seq_length=T, feature_size=C, timesteps=500, sampling_timesteps=500,
                loss_type="l2", beta_schedule="cosine", n_heads=4, mlp_hidden_times=4,
                attn_pd=0.0, resid_pd=0.0, kernel_size=1, padding_size=0,
                # 0, not 0.0008: the cross-channel correlation MMD term is undefined
                # at C=1. See vendor/DiM-TS/cgm_train_sample.py.
                mmd_alpha=0.0, l_loss=1.0, sample_type="batch",
                hidden_size=int(h), n_encoder=1, n_decoder=3,
                feature_last=True, input_shape=[T, C], mlp_ratio=4.0,
                d_state=1, d_conv=3, model_type="DiM", conv_num=1)


dev = torch.device("cuda")
rows = []
for h in [int(w) for w in os.environ["WIDTHS"].split()]:
    model = DiM_TS(**cfg(h)).to(dev)
    n_par = sum(p.numel() for p in model.parameters())
    opt = torch.optim.Adam(model.parameters(), lr=1e-4)
    x = torch.randn(BATCH, T, C, device=dev)

    for _ in range(5):                   # the first steps include kernel autotuning
        opt.zero_grad(); model(x).backward(); opt.step()
    torch.cuda.synchronize()

    t0 = time.time()
    for _ in range(50):
        opt.zero_grad(); model(x).backward(); opt.step()
    torch.cuda.synchronize()
    per_step = (time.time() - t0) / 50

    # sampling at the batch the real run uses, not the probe default: DiM-TS measured
    # 101.6 ms/sample at batch 64 against 39.1 at 256, and sample_batch is 1000.
    model.eval()
    torch.cuda.synchronize(); t0 = time.time()
    with torch.no_grad():
        model.generate_mts(batch_size=SAMPLE_BATCH)
    torch.cuda.synchronize()
    per_sample = (time.time() - t0) / SAMPLE_BATCH

    train_h = per_step * STEPS * 2 / 3600
    sample_h = per_sample * K / 3600
    rows.append(dict(hidden_size=h, params=n_par, ms_per_step=round(per_step * 1e3, 2),
                     ms_per_sample=round(per_sample * 1e3, 3),
                     train_hours=round(train_h, 2), sample_hours=round(sample_h, 2),
                     hours_per_model=round(train_h + sample_h, 2),
                     gpu_hours_123_models=round((train_h + sample_h) * 123, 1)))
    print(f"hidden_size={h:<4} {n_par:>10,} par  {per_step*1e3:6.1f} ms/step  "
          f"{per_sample*1e3:6.2f} ms/sample  -> {train_h + sample_h:5.2f} h/model",
          flush=True)
    del model, opt, x
    torch.cuda.empty_cache()

with open(os.environ["OUT"], "w") as f:
    json.dump(rows, f, indent=2)
print(f"wrote {os.environ['OUT']}", flush=True)
PY
}

pids=(); rc=0
for i in "${!ALL[@]}"; do
    card=${ALLOC[$(( i % ${#ALLOC[@]} ))]}
    ( export CUDA_VISIBLE_DEVICES="$card"
      probe_one "${ALL[$i]}" "h${ALL[$i]}"
    ) > "$REPO/logs/06c_${PBS_JOBID%%.*}_h${ALL[$i]}.log" 2>&1 &
    pids+=($!)
    echo "width ${ALL[$i]} -> $card  (pid ${pids[$i]})"
done
# Individually: a bare `wait` reports only the last task, and a run where every task
# died has reported Exit_status=0 that way before.
for i in "${!pids[@]}"; do
    if wait "${pids[$i]}"; then echo "width ${ALL[$i]} OK"
    else echo "width ${ALL[$i]} FAILED"; rc=1; fi
done

echo
for w in "${ALL[@]}"; do
    echo "--- h=$w ---"; cat "$REPO/logs/06c_${PBS_JOBID%%.*}_h${w}.log"
done

# REPO is a plain shell variable in env.sh, not exported -- pass it explicitly or the
# merge below dies on KeyError after every width has already been paid for.
REPO="$REPO" python - <<'PY'
import glob, json, os
rows = []
for p in sorted(glob.glob(os.path.join(os.environ["REPO"], "results/probe/capacity_h*.json"))):
    rows += json.load(open(p))
if not rows:
    raise SystemExit("no width completed")
rows.sort(key=lambda r: r["hidden_size"])
out = os.path.join(os.environ["REPO"], "results/probe/capacity.json")
json.dump(rows, open(out, "w"), indent=2)

ref = rows[0]
print(f"\n{'hidden':>7}{'params':>12}{'h/model':>10}"
      f"{'vs h=%d' % ref['hidden_size']:>9}{'123 models':>12}")
for r in rows:
    print(f"{r['hidden_size']:>7}{r['params']:>12,}{r['hours_per_model']:>10.2f}"
          f"{r['hours_per_model'] / ref['hours_per_model']:>8.2f}x"
          f"{r['gpu_hours_123_models']:>11.0f}h")
print("\n123 models = 3 replicates x (1 base + 20 outlier + 20 control).")
print(f"wrote {out}")
PY
exit $rc
