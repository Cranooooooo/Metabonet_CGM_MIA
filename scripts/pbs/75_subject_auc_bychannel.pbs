#!/bin/bash
#PBS -N cgm_sauc
#PBS -P 11704243
#PBS -j oe
#
# One membership AUC PER SUBJECT, per channel. AUC_t = P(d_out > d_in) over that
# subject's own windows -- "how attackable is this person" -- where 0.5 means the
# attack cannot tell, for him, which model saw him.
#
# This is a different question from the arm AUC reported earlier. The arm AUC asks
# whether the outlier GROUP separates from the control GROUP and, at 13 vs 18 targets,
# carries a standard error of 0.107 -- so everything between 0.29 and 0.71 was
# indistinguishable from no effect. AUC_t is computed over one subject's ~30-270
# windows and does not depend on the other arm at all, so it is not affected by the
# arms being unbalanced while the campaign is still running.
#
#   qsub -l select=1:ncpus=32:mem=128gb -l walltime=02:00:00 \
#        -o logs/75_subject_auc.log scripts/pbs/75_subject_auc_bychannel.pbs    # -> qdev
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
{
  for CH in CGM basal bolus; do
    echo "########## channel: $CH ##########"
    python -u scripts/subject_auc.py \
      --runs dimts_c3_h128 --design results/design_sid_c3 \
      --cohort data/cohort/metabonet_sid_c3 \
      --replicates 1 --channels "$CH" --skip-missing \
      --out "results/subject_auc_c3/${CH}"
  done
} 2>&1 | tee logs/75_subject_auc.live.log
