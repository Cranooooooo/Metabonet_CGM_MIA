#!/bin/bash
#PBS -N cgm_push
#PBS -P 11704243
#PBS -j oe
#
# Push docs/report. A job rather than a login-node command: git hashes and compresses every
# staged file, and NSCC auto-flags login-node compute (NSCC_operation_guide_book.md 1).
# github.com is reachable over HTTPS only; git needs `module load git/2.39.2` on a compute node.
#
#   qsub -l select=1:ncpus=8:mem=32gb -l walltime=00:30:00 \
#        -o logs/98_push_report.log scripts/pbs/98_push_report.pbs            # -> qdev
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
set +e
module load git/2.39.2
cd "$REPO"
{
  git add -A
  echo "staged: $(git diff --cached --numstat | wc -l) files"
  git commit -q -F - <<'MSG'
Report in English, and fix a duplicate id that broke the flow section

`<h2 id="flow">` and the step container `<div id="flow">` shared an id, so `$('#flow')`
resolved to the heading and all seven step cards were appended inside it. The container
is now `flowSteps`.

Chart margins are widened where the English labels are longer than the Chinese ones they
replace (replicate legend, window-length and width annotations, channel panel titles).

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
MSG
  git log --oneline -1
  git -c credential.helper="store --file=$HOME/.git-credentials-github" \
      push origin main 2>&1 | sed -E 's#//[^@]*@#//***@#g'
  echo "push exit ${PIPESTATUS[0]}"
} 2>&1 | tee logs/98_push_report.live.log
