#!/bin/bash
#PBS -N cgm_consec
#PBS -P 11704243
#PBS -j oe
#
# Prerequisite for proposal 2 (week / fortnight / month windows): do subjects have that
# many CONSECUTIVE complete days? The cohort's days are complete individually; nothing
# has ever checked that they are contiguous.
#
#   qsub -l select=1:ncpus=8:mem=32gb -l walltime=00:30:00 \
#        -o logs/59_consecutive.log scripts/pbs/59_consecutive.pbs              # -> qdev
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
python -u scripts/consecutive_days.py 2>&1 | tee logs/59_consecutive.live.log
