#!/bin/bash
#PBS -N cgm_d7r
#PBS -P 11704243
#PBS -j oe
#
# The other twenty seven-day models, at the budget the base model converged to.
#
# 34,000 STEPS, NOT 3,700 AND NOT 59,200. The base run was allowed to go to 16x and
# watched: binned over 6,000 steps the loss fell 0.09531 -> 0.01338 -> 0.01278 ->
# 0.01257 -> 0.01247, and the last two 2,000-step bins changed -0.24% and -0.16%.
# checkpoint-17 is step 34,000 and base was sampled FROM IT, so every model here shares
# base's training budget exactly. A budget difference between the two arms would enter
# every gap directly.
#
# Eight cards over three lanes because each g* queue admits one running job per user
# above two hours (guide 3). At 34,000 steps a model is ~152 min training + ~41 min
# sampling = 3.2 h, so the busiest shard of three models is 9.7 h. 14 h is requested:
# the three-channel campaign died because its walltimes were budgeted with no margin.
#
#   qsub -l select=1:ncpus=64:ngpus=4 -l walltime=14:00:00 -v SHARD_BASE=0,N_SHARDS=8 ...  -> g3
#   qsub -l select=1:ncpus=48:ngpus=3 -l walltime=14:00:00 -v SHARD_BASE=4,N_SHARDS=8 ...  -> g2
#   qsub -l select=1:ncpus=16:ngpus=1 -l walltime=14:00:00 -v SHARD_BASE=7,N_SHARDS=8 ...  -> g1
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
module load cuda/11.8.0
export DIMTS_PYTHON=$WORK/envs/dimts/bin/python
export LD_LIBRARY_PATH="$WORK/envs/dimts/lib:$WORK/envs/dimts/lib/python3.10/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"

DSN=results/design_d7_pilot/rep1
OUT=results/runs/dimts_d7_conv_rep1
COH=data/cohort/metabonet_sid_c1_d7_contiguous
LOGTAG=${PBS_JOBID%%.*}
: "${SHARD_BASE:?}"; : "${N_SHARDS:?}"

test -f "$OUT/base/samples.npy" || { echo "base has no samples yet; it must be resampled first"; exit 1; }

IFS=',' read -ra ALLOC <<< "${CUDA_VISIBLE_DEVICES:-0}"
export THREADS=$(( ${NCPUS:-16} / ${#ALLOC[@]} ))
echo "PBS allocated ${#ALLOC[@]} GPU(s), shards ${SHARD_BASE}..$(( SHARD_BASE + ${#ALLOC[@]} - 1 )) of $N_SHARDS"

pids=(); rc=0
for i in "${!ALLOC[@]}"; do
    s=$(( SHARD_BASE + i ))
    ( export CUDA_VISIBLE_DEVICES="${ALLOC[$i]}"
      python scripts/run_loo.py --design "$DSN" --out "$OUT" --cohort "$COH" \
        --shard "$s" --n-shards "$N_SHARDS" \
        --params '{"hidden_size": 96, "steps": 34000, "save_cycle": 34000}'
    ) > "logs/84_${LOGTAG}_shard${s}.log" 2>&1 &
    pids+=($!)
    echo "shard $s -> ${ALLOC[$i]}"
done
for i in "${!pids[@]}"; do
    if wait "${pids[$i]}"; then echo "shard $(( SHARD_BASE + i )) OK"
    else echo "shard $(( SHARD_BASE + i )) FAILED"; rc=1; fi
done
echo "$(find "$OUT" -name samples.npy | wc -l) / 21 models"
exit $rc
