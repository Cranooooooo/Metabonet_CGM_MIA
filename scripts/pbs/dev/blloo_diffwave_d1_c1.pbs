#!/bin/bash
#PBS -N bl_diff_c1
#PBS -P 11704243
#PBS -l select=1:ncpus=16:ngpus=4:mem=110gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/blloo_diffwave_d1_c1.log
#
# diffwave 在 d1_c1 上的 26 个 include。gdev(<=2h,4 卡)是眼下唯一空着的队列 ——
# g1/g2/g3 全被 isl_* 占着,glong 被 ipb_d7 占着。
# 2 小时装不下全部 26 个,所以这个作业【设计成可以反复重排】,每轮推进一批。
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
GEN=diffwave CELL=d1_c1 NSHARD=4 bash scripts/pbs/dev/baseline_loo.body.sh
