#!/bin/bash
#PBS -N dts_c2
#PBS -P 11704243
#PBS -l select=1:ncpus=64:ngpus=4:mem=440gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/blloo_diffusion_ts_d1_c2.log
#
# diffusion_ts 在 d1_c2 上的 26 个 include。队列由 (ngpus=4, walltime=02:00:00) 决定,不指名。
# 走长队列而不是 gdev:一次跑完,不用接力,也不会有模型卡在 2 小时墙上被丢掉
# —— 这三个适配器【没有断点续训】,模型内部没有部分学分。
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
GEN=diffusion_ts CELL=d1_c2 NSHARD=4 bash scripts/pbs/dev/baseline_loo.body.sh
