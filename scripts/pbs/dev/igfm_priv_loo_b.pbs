#!/bin/bash
#PBS -N igfmpriv_b
#PBS -P 11704243
#PBS -l select=1:ncpus=48:ngpus=3:mem=330gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o logs/igfm_priv_loo_b.log
#
# 同一批实验的后半 —— 分片 4-6(共 7 片)。正文和 a 完全共用一个文件,
# 参数只写在那一处,两半不可能训出配置不同的模型。
#
# 3 张卡 + 2-24 小时 -> g2。g2 提交时有 6 个人在排,起得可能比 a 晚几个小时;
# 起不来也没关系,a 那 4 张卡先把分片 0-3 做掉,剩下的分片任何时候补跑都行。
# 收尾的攻击和打分不看「谁跑完了」,只看目录里够不够 27 个模型,
# 所以两半谁先谁后都不影响。
#
#   qsub scripts/pbs/dev/igfm_priv_loo_b.pbs

source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"; cd "$REPO"


SHARDS="4 5 6"
source scripts/pbs/dev/igfm_priv_loo.body.sh
