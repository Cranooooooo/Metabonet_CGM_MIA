#!/bin/bash
#PBS -N cgm_rebuild
#PBS -P 11704243
#PBS -j oe
#
# Rebuild both cohorts on the corrected subject key (source_file, id). One channel and
# three channels, same rules otherwise, so the single/multi comparison is not also a
# comparison of subject definitions.
#
#   qsub -l select=1:ncpus=16:mem=200gb -l walltime=02:00:00 \
#        -o logs/55_rebuild_cohorts.log scripts/pbs/55_rebuild_cohorts.pbs     # -> qdev
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
{
  python -m py_compile scripts/build_cohort_multi.py scripts/verify_cohort_multi.py \
                       scripts/identifiability.py
  echo "--- single channel, corrected key ---"
  python -u scripts/build_cohort_multi.py --subject-key study_id \
    --channels CGM --out data/cohort/metabonet_sid_c1
  python -u scripts/verify_cohort_multi.py --cohort data/cohort/metabonet_sid_c1 \
    --cells results/channel_coverage_studyid/cells_per_day.parquet --channels CGM
  echo "--- three channels, corrected key ---"
  python -u scripts/build_cohort_multi.py --subject-key study_id \
    --channels CGM basal bolus --out data/cohort/metabonet_sid_c3
  python -u scripts/verify_cohort_multi.py --cohort data/cohort/metabonet_sid_c3 \
    --cells results/channel_coverage_studyid/cells_per_day.parquet
} 2>&1 | tee logs/55_rebuild_cohorts.live.log
