#!/bin/bash
#PBS -N cgm_subject_risk
#PBS -P 11704243
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/16_subject_risk.log
#
# Decompose the arm difference: is AUC 0.68 a property of the outlier group, or of a
# few people inside it? Reads the three replicates' gaps.parquet and writes
# results/attack/dimts_h128_subject_risk/. No GPU, no training -- qdev, priority 100.
#
# The two claims this separates are not interchangeable. "Outlier subjects leak more"
# and "three particular subjects leak a lot and the other seventeen do not" have the
# same AUC and different consequences for who needs protecting.
#
# It also runs the guard that has to pass before ANY per-subject number is quoted:
# whether a subject's exposure ranks consistently across three independent runs. The
# frozen statistic's own docstring warns that one target's gap carries training noise;
# three replicates make the per-subject question askable, they do not make it answered.
#
#   qsub scripts/pbs/16_subject_risk.pbs

source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"

python scripts/subject_risk.py --runs "${RUNS:-dimts_h128}" --replicates "${REPS:-3}"
