#!/bin/bash
#PBS -N cgm_pooled
#PBS -P 11704243
#PBS -j oe
#
# The pooled-classifier attacker panel: one attack model shared by every subject,
# leave-one-subject-out, one AUC per subject. Replaces the per-subject protocol, whose
# negative control showed it was measuring release identity (docs/PITFALLS.md).
#
#   qsub -l select=1:ncpus=32:mem=8gb -l walltime=02:00:00 \
#        -o logs/31_panel_pooled.log scripts/pbs/31_attack_panel_pooled.pbs   # -> qdev
#
# Reads the features stage A already wrote, so this costs no distance matrices. The
# expensive cells are the SVM (O(n^2), capped at 8k training rows) and the MLP; the
# whole panel measured around 40 min, inside the 2 h that keeps it in qdev.

# ⛔ NEVER put a comma inside a -v value. PBS splits the -v list on commas, so
#   -v CELLS="a!x,b!y"
# is read as two variables and the submit fails outright with `qsub: cannot send
# environment with the job`. This is the same trap as passing inline JSON, where the
# double quotes are stripped instead (docs/PLAN.md). Structure goes through a flag that
# the script expands, never through the value itself.
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"

# PROBE=1 runs the two cheapest cells, to find a crash in three minutes rather than
# after the full panel's forty.
if [ -n "${PROBE:-}" ]; then
    CELLS='C1_logreg!F1_min,C2_tree!F3_raw10'
fi

python scripts/attack_panel_pooled.py \
    --panel "${PANEL:-results/attack_panel/dimts_h128}" \
    --out "${OUT:-results/attack_panel/table_pooled.json}" \
    ${CELLS:+--cells "$CELLS"}
