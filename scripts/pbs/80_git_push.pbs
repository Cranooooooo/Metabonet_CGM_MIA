#!/bin/bash
#PBS -N cgm_git
#PBS -P 11704243
#PBS -j oe
#
# Put this working tree under version control and push it to
# https://github.com/Cranooooooo/Metabonet_CGM_MIA (public, token has push).
#
# WHY THIS IS A JOB AND NOT TWO LINES ON THE LOGIN NODE. `git add` hashes and zlib-
# compresses every file it stages -- about 1,450 of them here. That is CPU work, and
# NSCC auto-flags login-node compute and raises a ticket against the project
# (NSCC_operation_guide_book.md 1). Compute nodes have outbound internet, so the push
# works from inside a job.
#
# WHY HTTPS AND NOT THE SSH URL THAT WAS ASKED FOR. github.com:22 and ssh.github.com:443
# are both unreachable from this machine ("No route to host" / "Connection reset").
# HTTPS returns 200. The remote is therefore the HTTPS URL; nothing else changes.
#
# The token is never written into .git/config: `credential.helper=store --file=...`
# reads the existing ~/.git-credentials-github for the push and leaves the remote clean.
#
#   qsub -l select=1:ncpus=8:mem=32gb -l walltime=01:00:00 \
#        -o logs/80_git_push.log scripts/pbs/80_git_push.pbs                    # -> qdev
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
set +e
module load git/2.39.2
command -v git >/dev/null || { echo "git still absent after module load"; exit 127; }
cd "$REPO"

{
  echo "########## connectivity from the compute node ##########"
  curl -sS -o /dev/null -w "  github.com: %{http_code}\n" --max-time 20 https://github.com

  echo "########## init ##########"
  if [ -d .git ]; then echo "  already a repository"; else git init -q; echo "  git init"; fi
  git config user.name  "Cranooooooo"
  git config user.email "lcheng2@ic.ac.uk"
  git symbolic-ref HEAD refs/heads/main

  echo "########## what will be committed ##########"
  git add -A
  echo "  $(git diff --cached --numstat | wc -l) files staged"
  echo "  largest staged files:"
  git diff --cached --name-only -z | xargs -0 -I{} sh -c 'test -f "{}" && stat -c "%s {}" "{}"' \
    2>/dev/null | sort -rn | head -8 | awk '{printf "    %8.1f MB  %s\n", $1/1048576, $2}'
  BIG=$(git diff --cached --name-only -z | xargs -0 -I{} sh -c 'test -f "{}" && stat -c "%s {}" "{}"' \
        2>/dev/null | awk '$1 > 104857600 {print $2}')
  if [ -n "$BIG" ]; then
     echo "  ABORT: over GitHub's 100 MB hard limit:"; echo "$BIG" | sed 's/^/    /'; exit 1
  fi
  echo "  symlinks staged (they point at this machine and will dangle elsewhere):"
  git diff --cached --name-only | while read -r f; do [ -L "$f" ] && echo "    $f -> $(readlink "$f")"; done

  echo "########## commit ##########"
  git commit -q -F - <<'MSG'
Three-channel cohort, corrected subject key, and the experiments that followed

The subject key was wrong: `id` is unique only within a source study, so 238 of the
875 published subjects were composites of 2-9 people. Re-keying on (source_file, id)
both fixes that and grows the usable cohort to 1,329.

Adds, on top of the published single-channel study:

  * scripts/channel_coverage.py, build_cohort_multi.py, build_cohort_multiday.py --
    multi-channel and multi-day cohorts; the "insulin channels cost 63% of subjects"
    claim in cohort.py is measured at 4.7%
  * scripts/identifiability.py -- the real-data ceiling on any membership attack, with
    a within-study control. One day of basal identifies its subject 29% of the time,
    one day of CGM 1.5%
  * multichannel outlier detection (outliers/run.py --channels), per-channel attack
    and per-subject AUC
  * docs/MEMO.md -- what each experiment settled, including three negative results:
    capacity does not close the three-channel quality gap, window length does not move
    the attack ceiling, and adding channels dilutes the one real membership signal
  * docs/PITFALLS.md 13-15 -- the id collision, a float32 reduction that silently
    stalls, and an outlier list that does not survive a change of machine

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
MSG
  git log --oneline -1

  echo "########## push ##########"
  git remote remove origin 2>/dev/null
  git remote add origin https://github.com/Cranooooooo/Metabonet_CGM_MIA.git
  git branch -M main
  git -c credential.helper="store --file=$HOME/.git-credentials-github" \
      push -u origin main 2>&1 | sed -E 's#//[^@]*@#//***@#g'
  rc=${PIPESTATUS[0]}
  echo "push exit $rc"
  exit $rc
} 2>&1 | tee logs/80_git_push.live.log
