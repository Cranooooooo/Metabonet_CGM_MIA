#!/bin/bash
#PBS -N cgm_discst
#PBS -P 11704243
#PBS -j oe
#
# Is the seven-day quality collapse capacity or data volume? The reading that was going
# to answer it turned out to be one draw of an unseeded classifier -- h96 scored 0.9475
# and 0.5908 on the same samples.npy. So take the distribution.
#
# Three runs, eight restarts each, one fixed subsample so that ONLY the classifier's
# initialisation moves:
#   dimts_d7_conv_rep1  h96,  seven days   -- reached 0.9475 once, so it IS separable
#   dimts_d7_h256_rep1  h256, seven days   -- the capacity test, one reading so far
#   cp_d7_contiguous_rep1  copy_paste      -- the anchor: verbatim copies must stay ~0.53
#
#   qsub -l select=1:ncpus=16:ngpus=1 -l walltime=25:00:00 \
#        -o logs/87_disc_stability.log scripts/pbs/87_disc_stability.pbs       # -> glong
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
module load cuda/11.8.0
export THREADS=${NCPUS:-16}
python -u scripts/disc_stability.py \
  --runs results/runs/dimts_d7_conv_rep1/base \
         results/runs/dimts_d7_h256_rep1/base \
         results/runs/cp_d7_contiguous_rep1/base \
  --cohort data/cohort/metabonet_sid_c1_d7_contiguous \
  --job-file results/design_d7_pilot/rep1/jobs/base.json \
  --restarts 8 \
  --out results/quality_d7_h256/disc_stability.json 2>&1 | tee logs/87_disc_stability.live.log
