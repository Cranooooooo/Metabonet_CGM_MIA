#!/bin/bash
#PBS -N cgm_st50
#PBS -P 11704243
#PBS -l select=1:ncpus=64:ngpus=4:mem=440gb
#PBS -l walltime=12:00:00
#PBS -j oe
#
# Does sampling_timesteps 500 -> 50 change the answer?
#
# WHY IT MATTERS. The epoch sweep wants 5 checkpoints x 4 cells x 27 models. At 500
# denoising steps that is ~485 GPU.h of pure sampling, which is the same order as the
# whole training campaign. At 50 steps it is ~49. So the sweep is affordable if and only
# if 50 steps preserves the MIA conclusion and the quality ranking.
#
# WHAT IS HELD FIXED. Same checkpoints (milestone 10 = end of training), same K, same
# seed, same everything -- resample() reads the architecture from the run's own
# config.json and only sample-time knobs are the caller's. So any difference is the
# denoising budget and nothing else.
#
# It writes to matrix_<cell>_st50 rather than in place: a step count produces samples the
# run's own meta.json does not describe, and overwriting would leave nothing to compare.
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
cd "$REPO"
# DiM-TS runs in its own interpreter; B2_matrix_train.pbs exports these and this job did
# not, so all 81 children died on "no interpreter given" -- and still reported OK.
export DIMTS_PYTHON=$WORK/envs/dimts/bin/python
export LD_LIBRARY_PATH="$WORK/envs/dimts/lib:$WORK/envs/dimts/lib/python3.10/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
{
set -euo pipefail
IFS=',' read -ra GPU <<< "${CUDA_VISIBLE_DEVICES:-0}"
FAIL=0; declare -a pids names
NG=${#GPU[@]}
DSN=results/matrix/design/rep1
i=0
for CELL in d1_c1 d1_c2 d7_c1; do
  case "$CELL" in d7_*) SB=100 ;; *) SB=500 ;; esac
  OUT=results/runs/matrix_${CELL}_st50
  mkdir -p "$OUT"
  for RUN in results/runs/matrix_$CELL/*/; do
    NAME=$(basename "$RUN")
    [ -f "$OUT/$NAME/samples.npy" ] && continue
    slot=$(( i % NG ))
    dev=${GPU[$slot]}
    ( export CUDA_VISIBLE_DEVICES="$dev"
      python -u scripts/resample.py \
        --from-run "$RUN" --job-file "$DSN/jobs/$NAME.json" \
        --cohort "data/cohort/matrix_$CELL" --out "$OUT/$NAME" \
        --sampling-timesteps 50 --milestone 10 \
        --params "{\"sample_batch\": $SB}"
    ) >> "logs/D1_st50_${CELL}_slot${slot}.log" 2>&1 &
    pids[$slot]=$!; names[$slot]="$CELL/$NAME"
    i=$((i+1))
    if [ $(( i % NG )) -eq 0 ]; then
      for s in "${!pids[@]}"; do
        # `( ... ) &` failures do not reach set -e, so the first version of this script
        # ran 81 children that ALL died on a missing interpreter and still printed OK.
        wait "${pids[$s]}" || { echo "FAILED: ${names[$s]} -- see logs/D1_st50_*_slot$s.log"; FAIL=1; }
      done
      pids=(); names=()
    fi
  done
  for s in "${!pids[@]}"; do
    wait "${pids[$s]}" || { echo "FAILED: ${names[$s]}"; FAIL=1; }
  done
  pids=(); names=()
  n=$(find -L "$OUT" -name samples.npy | grep -c . )
  echo "$CELL: $n / 27 resampled at 50 steps"
  [ "$n" -eq 27 ] || { echo "INCOMPLETE: $CELL has $n of 27"; FAIL=1; }
done
[ "${FAIL:-0}" -eq 0 ] || { echo "ST50 FAILED -- do not read the comparison"; exit 1; }
echo "ST50 OK"
} 2>&1 | tee logs/D1_st50.live.log
