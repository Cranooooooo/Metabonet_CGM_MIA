#!/bin/bash
#PBS -N cgm_rederive
#PBS -P 11704243
#PBS -l select=1:ncpus=64:ngpus=1:mem=440gb
#PBS -l walltime=08:00:00
#PBS -j oe
#
# Re-derive the outlier consensus with the B5/B6 medoid bug fixed.
#
# THE BUG. outliers/shape.py:120 read `cur[med]` where `med` indexes W, the per-subject-
# capped subsample. On the published run len(W) was 26,250 against len(cur) 182,597, so
# B5 and B6 -- 2 of the 13 consensus votes -- were scored against three arbitrary windows
# from the low-id end of a (id, day)-sorted array instead of the glucotype medoids.
# Deterministic given the seed, so every reproducibility check confirmed a stable wrong
# answer (PITFALLS section 15 records B5 at Jaccard 1.000 across machines).
#
# WHICH COHORT. The battery was scored on data/cohort/matrix_d1_c1 when it held 107,927
# windows; that directory now holds the 6,072-window block-matched training cohort. The
# eleven unaffected methods' parquets are only valid against the cohort that produced
# them, so the full record is reconstructed here as matrix_detect and B5/B6 recomputed
# against THAT. Mixing the two would re-score two methods on a 17x smaller sample and
# leave eleven scored on the original -- the exact "different denominators" failure the
# consensus cut guards against.
#
# A note on what is being assumed, because it is a real fork and not an obvious call:
# outlier status is taken as a property of the PERSON, established on their whole record,
# while the generators train on ~12 days each. The alternative -- define outliers on the
# training cohort, so the target is outlying in the data the model actually saw -- is a
# different and noisier study. Stated here rather than buried.
source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
cd "$REPO"
{
set -euo pipefail

echo "########## 1. reconstruct the detection cohort (full record, 506 subjects) ##########"
if [ ! -f data/cohort/matrix_detect/manifest.json ]; then
  python -u scripts/build_cohort_matched.py \
    --src data/cohort/metabonet_sid_c1 \
    --subjects results/matrix/final_subjects.txt \
    --out data/cohort/matrix_detect
fi
python -u -c "
import json; m=json.load(open('data/cohort/matrix_detect/manifest.json'))
print(f\"  matrix_detect: {m['n_windows']:,} windows, {m['n_subjects']} subjects\")
assert m['n_windows'] == 107927, f\"expected 107,927 windows, got {m['n_windows']} -- \"\
  'this is not the cohort the other eleven methods were scored on'
assert m['n_subjects'] == 506
print('  matches the cohort the existing parquets were computed on')
"

echo
echo "########## 2. drop ONLY the two affected methods, per seed ##########"
for SD in results/matrix/outliers/seed*/; do
  rm -f "$SD/B5.parquet" "$SD/B6.parquet"
  echo "  cleared B5/B6 in $SD"
done

echo
echo "########## 3. recompute B5/B6 and re-run consensus + stability ##########"
# todo() now validates that every surviving parquet covers this cohort, so the eleven
# untouched methods are checked rather than assumed, and only B5/B6 are recomputed
python -u scripts/seed_stability.py --cohort data/cohort/matrix_detect \
  --out results/matrix/outliers --seeds 2026,7,101,999

echo
echo "########## 4. what changed ##########"
python -u -c "
import json
s = json.load(open('results/matrix/outliers/stability.json'))
old = ['DCLP3/91','DCLP5/52','DCLP5/81','Loop/100','Loop/1120','Loop/1142','Loop/1153',
       'Loop/19','Loop/342','Loop/467','Loop/633','Loop/727','Loop/968']
new = list(s['always'])
print(f'  always: {len(old)} -> {len(new)}')
print(f'  dropped: {sorted(set(old)-set(new)) or \"none\"}')
print(f'  added  : {sorted(set(new)-set(old)) or \"none\"}')
print(f'  sometimes ({len(s[\"sometimes\"])}): {sorted(s[\"sometimes\"])}')
"
echo
echo "REDERIVE OK"
} 2>&1 | tee logs/B4_rederive.live.log
