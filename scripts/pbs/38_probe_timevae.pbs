#!/bin/bash
#PBS -N cgm_probe_tv
#PBS -P 11704243
#PBS -j oe
#
# Is TimeVAE on the card, and is batch_size=16 why it is slow?
#
#   qsub -l select=1:ncpus=16:mem=64gb:ngpus=1 -l walltime=00:30:00 \
#        -o logs/38_probe_timevae.log scripts/pbs/38_probe_timevae.pbs      # -> gdev
#
# The run in flight shows 98% of one core over eight hours, which is the signature of
# CPU-only training AND of a GPU loop that is launch-bound at a tiny batch. Reading the
# vendored source settles neither: it does call .to(cuda-if-available), so the question
# is what happened at runtime, not what the code says.

source "${REPO:-$HOME/workspace/Project_CGM/CGM-OutlierMIA-master}/scripts/pbs/env.sh"
conda activate "$ENV_PREFIX"
module load cuda/11.8.0

python scripts/probe_timevae.py
