# -*- coding: utf-8 -*-
"""实验进程记录与审核模板 —— 渲染层(与具体项目无关,可复用)。

产出一个自包含的单文件 HTML:标题 + 问题陈述 + 横排步骤标签页,
每个标签页含 名称 / 目的与阶段 / 实施方案 / 目前进度 / 结果图表 / 编号结论 / 下一步。

图表遵循 lieflat-charts 的 Mono 规范(灰阶、发丝线、实心、明度即数据、单位可数),
图型全部取自其主力区(Lupi Basics F1/F5/F6/F8 与 Lupi Editorial L15),
几何与代码骨架沿用 templates/basics-gallery.html 与 lupi-gallery.html 的对应卡片。

用法:把 steps.py 里的 TITLE / LEAD / STEPS 换成自己的项目内容,重新运行即可。
"""
import html, json, os

HERE = os.path.dirname(os.path.abspath(__file__))
SKILL = os.path.expanduser("~/.claude/skills/lieflat-charts")

STATUS_STYLE = {
    "done": ("已完成", "#1C1C1A", "#F0EFEB"),
    "running": ("进行中", "#4A4944", "#F0EFEB"),
    "blocked": ("等待前序步骤", "#8F8E88", "#F0EFEB"),
    "todo": ("未开始", "#C6C5BF", "#1C1C1A"),
    "partial": ("部分完成", "#6A6963", "#F0EFEB"),
}

CHART_JS = r"""
/* ═══ 图表渲染器 ═══

   色系:lieflat-charts 的 WIRE(编辑部红)预设 —— 灰阶承载数据,
   荧光橙 #F5572F 是【唯一的视线落点】。硬规则:每张图只给一个元素上橙,
   第二处上橙就等于没有主角。整份交付锁定这一套,不与其他色系混用。

   图型选择:本页是【看板】,按 SKILL.md 第零节第 4 条,用户明确要求粗笔画、
   丰富图型时可以进入 Glance 体系;构成占比、前后对比、序列、双极偏离等形状
   仍优先从 Lupi Basics 取。一张图只承担一个独立结论,不堆同一种轮廓。
     tickDonut    <- F4 Tick Donut      (basics-gallery.html · B4)
     dumbbell     <- F12 Dumbbell Queue (basics-gallery.html · C8)
     hairlineLine <- F2 Hairline Line   (basics-gallery.html · B2)
     plumbScatter <- F8 Plumb Scatter   (basics-gallery.html · C4)
     tickGauge    <- F11 Tick Gauge     (basics-gallery.html · C7)
     chunkyBars / chunkyRows / pairedBars / divergingBar / tallyRows
                  <- G3 Chunky Bars 与 G10 Diverging Bar(glance-gallery.html)

   ⚠️ G3/G10 原版用 Chart.js 与 ECharts,而 Artifact 的内容安全策略拦截外部脚本。
   这里把它们的【几何与数据编码】移植到手写 SVG,保留核心比例:顶端胶囊圆角、
   柱宽占槽位 0.52、数值在柱顶、无网格无 Y 轴、明度按重要性沿灰阶分配。
   ⚠️ 几何全部由画布宽高推出,不写死尺寸 —— 通栏行里沿用半宽卡的常数会裁掉标签。 */
const {el, txt, tip, pol, rnd} = MONO;
const W_ = {BG:'#F0F0EE', TXT:'#1F1E1C', DATA:'#22211F', DATA2:'#8F8E86',
  FAINT:'#C0BFB7', MUT:'rgba(31,30,28,.60)', LAB:'rgba(31,30,28,.72)',
  GRID:'rgba(31,30,28,.16)', TRACK:'rgba(31,30,28,.12)', HERO:'#F5572F',
  SER:['#22211F','#8F8E86','#C0BFB7']};
const box = svg => { const v = svg.getAttribute('viewBox').split(/[\s,]+/).map(Number);
                     return {W:v[2], H:v[3]}; };
const D2R = Math.PI/180;
/* 明度即数据:按数值排名分配灰阶。hero 索引单独上橙,其余一律灰 */
function shades(vals, hero){
  const rank=vals.map((v,i)=>[v,i]).sort((a,b)=>b[0]-a[0]).map(x=>x[1]);
  const ladder=['#22211F','#4A4944','#6E6D66','#8F8E86','#ADACA4','#C0BFB7','#D5D4CD'];
  const out=new Array(vals.length);
  rank.forEach((idx,r)=> out[idx]=ladder[Math.min(ladder.length-1,r)]);
  if(hero!=null && hero>=0) out[hero]=W_.HERO;
  return out;
}
function capBar(svg,x,yTop,yBase,w,fill,delay){
  const r=Math.min(w/2,Math.max(0,(yBase-yTop)/2));
  el(svg,'path',{d:`M ${x-w/2} ${yBase} L ${x-w/2} ${yTop+r} Q ${x-w/2} ${yTop} ${x-w/2+r} ${yTop}`
    +` L ${x+w/2-r} ${yTop} Q ${x+w/2} ${yTop} ${x+w/2} ${yTop+r} L ${x+w/2} ${yBase} Z`,
    fill,class:'fade',style:`animation-delay:${delay}s`});
}
function capBarH(svg,y,xL,xR,h,fill,delay){
  const r=Math.min(h/2,Math.max(0,(xR-xL)/2));
  el(svg,'path',{d:`M ${xL} ${y-h/2} L ${xR-r} ${y-h/2} Q ${xR} ${y-h/2} ${xR} ${y-h/2+r}`
    +` L ${xR} ${y+h/2-r} Q ${xR} ${y+h/2} ${xR-r} ${y+h/2} L ${xL} ${y+h/2} Z`,
    fill,class:'fade',style:`animation-delay:${delay}s`});
}
const foot=(svg,W,H,t)=>txt(svg,{x:W/2,y:H-9,'font-size':8.5,'font-weight':600,
  fill:W_.FAINT,'text-anchor':'middle','letter-spacing':'.12em',class:'fade',
  style:'animation-delay:.9s'},t);

/* ── G3 · 竖向粗柱,数值在柱顶 ── */
function chunkyBars(svg,D,o){
  const {W,H}=box(svg), n=D.length, vals=D.map(d=>Math.abs(d[1]));
  const maxV=Math.max(...vals,o.ref??0)*1.18, base=H-66, top=72;
  const slot=Math.min(150,(W-96)/n), x0=i=>(W-(n-1)*slot)/2+i*slot, bw=slot*.52;
  const py=v=>base-(v/maxV)*(base-top), col=shades(vals,o.hero);
  if(o.ref!=null){
    const yr=py(o.ref);
    el(svg,'line',{x1:30,y1:yr,x2:W-30,y2:yr,stroke:W_.TXT,'stroke-width':1,
      'stroke-dasharray':'5 4',opacity:.45,class:'fade'});
    txt(svg,{x:W-30,y:yr-7,'font-size':9.5,'font-weight':700,fill:W_.LAB,'text-anchor':'end',
      'letter-spacing':'.05em',class:'fade'},o.refLabel||'');
  }
  D.forEach(([name,v,note],i)=>{
    const x=x0(i), y=py(Math.abs(v));
    capBar(svg,x,y,base,bw,col[i],i*.09);
    const num=txt(svg,{x,y:y-13,'font-size':15,'font-weight':700,fill:col[i]===W_.HERO?W_.HERO:W_.TXT,
      'text-anchor':'middle',class:'fade',style:`animation-delay:${.3+i*.09}s`},o.fmt(v));
    tip(num,note||`${name} — ${o.fmt(v)}`);
    name.split('\n').forEach((ln,li)=>txt(svg,{x,y:base+22+li*13,'font-size':10,'font-weight':600,
      fill:W_.MUT,'text-anchor':'middle','letter-spacing':'.04em',class:'fade',
      style:`animation-delay:${i*.09}s`},ln));
  });
  el(svg,'line',{x1:30,y1:base,x2:W-30,y2:base,stroke:W_.GRID,'stroke-width':1,class:'fade'});
  foot(svg,W,H,o.foot);
}

/* ── G3 横向变体 ── */
function chunkyRows(svg,D,o){
  const {W,H}=box(svg), vals=D.map(d=>d[1]);
  const maxV=Math.max(...vals,o.ref??0)*1.04, X0=o.labelW||210, span=W-X0-104;
  const rowH=(H-84)/D.length, y0=i=>52+i*rowH+rowH/2, bh=Math.min(30,rowH*.46);
  const col=shades(vals,o.hero);
  el(svg,'line',{x1:X0,y1:44,x2:X0,y2:H-34,stroke:W_.GRID,'stroke-width':1,class:'fade'});
  if(o.ref!=null){
    const xr=X0+(o.ref/maxV)*span;
    el(svg,'line',{x1:xr,y1:40,x2:xr,y2:H-38,stroke:W_.TXT,'stroke-width':1,
      'stroke-dasharray':'5 4',opacity:.45,class:'fade'});
    txt(svg,{x:xr,y:34,'font-size':9.5,'font-weight':700,fill:W_.LAB,'text-anchor':'middle',
      'letter-spacing':'.05em',class:'fade'},o.refLabel||'');
  }
  D.forEach(([name,v,note],i)=>{
    const y=y0(i), xr=X0+(v/maxV)*span;
    name.split('\n').forEach((ln,li)=>txt(svg,{x:X0-16,y:y+4+(li-(name.split('\n').length-1)/2)*13,
      'font-size':11,'font-weight':600,fill:W_.LAB,'text-anchor':'end','letter-spacing':'.03em',
      class:'fade',style:`animation-delay:${i*.09}s`},ln));
    capBarH(svg,y,X0,xr,bh,col[i],i*.09);
    const lab=txt(svg,{x:xr+13,y:y+5,'font-size':14,'font-weight':700,
      fill:col[i]===W_.HERO?W_.HERO:W_.TXT,class:'fade',
      style:`animation-delay:${.3+i*.09}s`},o.fmt(v));
    tip(lab,note||`${name} — ${o.fmt(v)}`);
  });
  foot(svg,W,H,o.foot);
}

/* ── G3 分组变体:淡 = 系列一,墨 = 系列二 ── */
function pairedBars(svg,D,o){
  const {W,H}=box(svg), n=D.length;
  const maxV=Math.max(...D.flatMap(d=>[d[1],d[2]]))*1.2, base=H-66, top=72;
  const slot=Math.min(165,(W-96)/n), x0=i=>(W-(n-1)*slot)/2+i*slot, bw=slot*.24;
  const py=v=>base-(v/maxV)*(base-top);
  D.forEach(([name,a,b,note],i)=>{
    const xa=x0(i)-bw*.62, xb=x0(i)+bw*.62, hero=(o.hero===i);
    capBar(svg,xa,py(a),base,bw,W_.FAINT,i*.09);
    capBar(svg,xb,py(b),base,bw,hero?W_.HERO:W_.DATA,.1+i*.09);
    txt(svg,{x:xa,y:py(a)-10,'font-size':11,'font-weight':700,fill:W_.DATA2,'text-anchor':'middle',
      class:'fade',style:`animation-delay:${.35+i*.09}s`},o.fmt(a));
    const num=txt(svg,{x:xb,y:py(b)-10,'font-size':13,'font-weight':700,
      fill:hero?W_.HERO:W_.TXT,'text-anchor':'middle',class:'fade',
      style:`animation-delay:${.4+i*.09}s`},o.fmt(b));
    tip(num,note||`${name} — ${o.fmt(a)} → ${o.fmt(b)}`);
    name.split('\n').forEach((ln,li)=>txt(svg,{x:x0(i),y:base+22+li*13,'font-size':10,
      'font-weight':600,fill:W_.MUT,'text-anchor':'middle','letter-spacing':'.04em',
      class:'fade',style:`animation-delay:${i*.09}s`},ln));
  });
  el(svg,'line',{x1:30,y1:base,x2:W-30,y2:base,stroke:W_.GRID,'stroke-width':1,class:'fade'});
  foot(svg,W,H,o.foot);
}

/* ── G10 · 双极偏离:以参照线为零点,左负右正 ── */
function divergingBar(svg,D,o){
  const {W,H}=box(svg), vals=D.map(d=>d[1]);
  const m=Math.max(...vals.map(Math.abs))*1.16, X0=o.labelW||230;
  const span=W-X0-110, cx=X0+span*(0-(-m))/(2*m);
  const rowH=(H-88)/D.length, y0=i=>56+i*rowH+rowH/2, bh=Math.min(28,rowH*.44);
  el(svg,'line',{x1:cx,y1:44,x2:cx,y2:H-38,stroke:W_.TXT,'stroke-width':1.2,opacity:.5,class:'fade'});
  txt(svg,{x:cx,y:36,'font-size':9.5,'font-weight':700,fill:W_.LAB,'text-anchor':'middle',
    'letter-spacing':'.05em',class:'fade'},o.zeroLabel||'0');
  D.forEach(([name,v,note],i)=>{
    const y=y0(i), xv=X0+span*(v+m)/(2*m), hero=(o.hero===i);
    txt(svg,{x:X0-16,y:y+4,'font-size':11,'font-weight':600,fill:W_.LAB,'text-anchor':'end',
      'letter-spacing':'.03em',class:'fade',style:`animation-delay:${i*.09}s`},name);
    const fill=hero?W_.HERO:(v>0?W_.DATA:W_.DATA2);
    if(v>=0) capBarH(svg,y,cx,xv,bh,fill,i*.09);
    else {   // 负向:从零点向左
      const r=Math.min(bh/2,Math.max(0,(cx-xv)/2));
      el(svg,'path',{d:`M ${cx} ${y-bh/2} L ${xv+r} ${y-bh/2} Q ${xv} ${y-bh/2} ${xv} ${y-bh/2+r}`
        +` L ${xv} ${y+bh/2-r} Q ${xv} ${y+bh/2} ${xv+r} ${y+bh/2} L ${cx} ${y+bh/2} Z`,
        fill,class:'fade',style:`animation-delay:${i*.09}s`});
    }
    const lab=txt(svg,{x:v>=0?xv+13:xv-13,y:y+5,'font-size':13.5,'font-weight':700,
      fill:hero?W_.HERO:W_.TXT,'text-anchor':v>=0?'start':'end',class:'fade',
      style:`animation-delay:${.3+i*.09}s`},o.fmt(v));
    tip(lab,note||`${name} — ${o.fmt(v)}`);
  });
  foot(svg,W,H,o.foot);
}

/* ── L15 派生 · 各项独立的 0–1 量表 ── */
function tallyRows(svg,D,o){
  const {W,H}=box(svg), X0=o.labelW||250, span=W-X0-92;
  const rowH=(H-84)/D.length, y0=i=>52+i*rowH+rowH/2, bh=Math.min(26,rowH*.44);
  D.forEach(([name,v,note,hi],i)=>{
    const y=y0(i), xr=X0+v*span;
    txt(svg,{x:X0-16,y:y+4,'font-size':11,'font-weight':hi?700:600,fill:hi?W_.HERO:W_.LAB,
      'text-anchor':'end','letter-spacing':'.03em',class:'fade',
      style:`animation-delay:${i*.09}s`},name);
    el(svg,'rect',{x:X0,y:y-bh/2,width:span,height:bh,fill:W_.TRACK,rx:bh/2,class:'fade'});
    capBarH(svg,y,X0,xr,bh,hi?W_.HERO:W_.DATA,i*.09);
    const lab=txt(svg,{x:X0+span+14,y:y+5,'font-size':14,'font-weight':700,
      fill:hi?W_.HERO:W_.TXT,class:'fade',style:`animation-delay:${.3+i*.09}s`},o.fmt(v));
    tip(lab,note||`${name} — ${o.fmt(v)}`);
  });
  if(o.chance!=null){
    const xc=X0+o.chance*span;
    el(svg,'line',{x1:xc,y1:42,x2:xc,y2:H-34,stroke:W_.TXT,'stroke-width':1,
      'stroke-dasharray':'5 4',opacity:.5,class:'fade'});
    txt(svg,{x:xc,y:36,'font-size':9.5,'font-weight':700,fill:W_.LAB,'text-anchor':'middle',
      'letter-spacing':'.05em',class:'fade'},o.chanceLabel||'随机水平');
  }
  foot(svg,W,H,o.foot);
}

/* ── F4 · 刻度环形:1 tick = 1%,段间留一格呼吸 ── */
function tickDonut(svg,D,o){
  const {W,H}=box(svg), cx=W*.38, cy=H/2-6, R0=Math.min(H*.30,110);
  const tot=D.reduce((a,d)=>a+d[1],0);
  const pcts=D.map(d=>Math.round(d[1]/tot*100));
  let fix=100-pcts.reduce((a,b)=>a+b,0); pcts[0]+=fix;      // 保证正好 100 格
  const ladder=['#4A4944','#6E6D66','#8F8E86','#ADACA4','#C0BFB7'];
  let k0=0;
  D.forEach(([name,v,note],si)=>{
    const shade = si===o.hero ? W_.HERO : ladder[Math.min(ladder.length-1,si)];
    for(let k=0;k<pcts[si];k++){
      const idx=k0+k, a=idx*3.6-90, len=12+rnd(idx+1,si+2)*7;
      const [x1,y1]=pol(cx,cy,R0,a), [x2,y2]=pol(cx,cy,R0+len,a);
      el(svg,'line',{x1,y1,x2,y2,stroke:shade,'stroke-width':1.6,class:'fade',
        style:`animation-delay:${idx*.009}s`});
      if(idx%10===0){const [dx,dy]=pol(cx,cy,R0-6,a);
        el(svg,'circle',{cx:dx,cy:dy,r:1,fill:W_.FAINT,class:'fade'});}
    }
    // 图例排在右侧,不用引线,避免通栏里引线乱穿
    const ly=cy-(D.length-1)*15+si*30, lx=W*.66;
    el(svg,'rect',{x:lx,y:ly-8,width:16,height:10,rx:5,fill:shade,class:'fade',
      style:`animation-delay:${.6+si*.08}s`});
    const t=txt(svg,{x:lx+24,y:ly+1,'font-size':11.5,'font-weight':si===o.hero?700:600,
      fill:si===o.hero?W_.HERO:W_.LAB,class:'fade',
      style:`animation-delay:${.62+si*.08}s`},`${name} · ${pcts[si]}%`);
    tip(t,note||`${name} — ${o.fmt(v)}`);
    k0+=pcts[si];
  });
  txt(svg,{x:cx,y:cy-2,'font-size':26,'font-weight':700,fill:W_.TXT,'text-anchor':'middle',
    class:'fade',style:'animation-delay:.9s'},o.center||'100');
  txt(svg,{x:cx,y:cy+18,'font-size':8.5,'font-weight':600,fill:W_.MUT,'text-anchor':'middle',
    'letter-spacing':'.1em',class:'fade',style:'animation-delay:.9s'},o.centerSub||'');
  foot(svg,W,H,o.foot);
}

/* ── F12 · 哑铃:空心 = 之前,实心 = 之后 ── */
function dumbbell(svg,D,o){
  const {W,H}=box(svg), X0=o.labelW||210, X1=W-104;
  const lo=Math.min(...D.flatMap(d=>[d[1],d[2]])), hi=Math.max(...D.flatMap(d=>[d[1],d[2]]));
  const pad=(hi-lo)*.12||1, mx=v=>X0+(v-lo+pad)/((hi-lo)+2*pad)*(X1-X0);
  const rowH=(H-92)/D.length, y0=i=>56+i*rowH+rowH/2;
  D.forEach(([name,a,b,note],i)=>{
    const y=y0(i), xa=mx(a), xb=mx(b);
    name.split('\n').forEach((ln,li)=>txt(svg,{x:X0-18,y:y+4+(li-(name.split('\n').length-1)/2)*13,
      'font-size':11,'font-weight':600,fill:W_.LAB,'text-anchor':'end','letter-spacing':'.03em',
      class:'fade',style:`animation-delay:${i*.09}s`},ln));
    el(svg,'line',{x1:X0-6,y1:y,x2:X1+6,y2:y,stroke:W_.TRACK,'stroke-width':.9,class:'fade'});
    el(svg,'line',{x1:xa,y1:y,x2:xb,y2:y,stroke:W_.DATA2,'stroke-width':2.4,class:'fade',
      style:`animation-delay:${.2+i*.09}s`});
    el(svg,'circle',{cx:xa,cy:y,r:6,fill:W_.BG,stroke:W_.DATA,'stroke-width':1.6,
      class:'pop',style:`animation-delay:${.2+i*.09}s`});
    const after=el(svg,'circle',{cx:xb,cy:y,r:7,fill:o.hero===i?W_.HERO:W_.DATA,
      class:'pop',style:`animation-delay:${.55+i*.09}s`});
    tip(after,note||`${name} — ${o.fmt(a)} → ${o.fmt(b)}`);
    txt(svg,{x:xa,y:y-15,'font-size':10.5,'font-weight':600,fill:W_.DATA2,'text-anchor':'middle',
      class:'fade',style:`animation-delay:${.3+i*.09}s`},o.fmt(a));
    txt(svg,{x:xb+16,y:y+5,'font-size':14,'font-weight':700,
      fill:o.hero===i?W_.HERO:W_.TXT,class:'fade',
      style:`animation-delay:${.65+i*.09}s`},o.fmt(b));
  });
  txt(svg,{x:X0,y:H-26,'font-size':9,'font-weight':600,fill:W_.FAINT,class:'fade'},o.leftLab||'');
  txt(svg,{x:X1,y:H-26,'font-size':9,'font-weight':600,fill:W_.FAINT,'text-anchor':'end',
    class:'fade'},o.rightLab||'');
  foot(svg,W,H,o.foot);
}

/* ── F2 · 发丝折线:多序列 + 逐点圆点 ── */
function hairlineLine(svg,S,o){
  const {W,H}=box(svg), LX=96, RX=W-64, TY=70, BY=H-76;
  const xs=o.x, n=xs.length;
  const all=S.flatMap(s=>s.v);
  const lo=Math.min(...all,0), hi=Math.max(...all)*1.1;
  const px=i=>LX+i/(n-1||1)*(RX-LX), py=v=>BY-(v-lo)/((hi-lo)||1)*(BY-TY);
  el(svg,'line',{x1:LX-24,y1:BY,x2:RX+22,y2:BY,stroke:W_.GRID,'stroke-width':1,class:'fade'});
  el(svg,'line',{x1:LX-24,y1:TY-14,x2:LX-24,y2:BY,stroke:W_.GRID,'stroke-width':1,class:'fade'});
  xs.forEach((lb,i)=>{
    el(svg,'line',{x1:px(i),y1:BY,x2:px(i),y2:BY-6,stroke:W_.TRACK,'stroke-width':.9,class:'fade'});
    txt(svg,{x:px(i),y:BY+22,'font-size':10,'font-weight':600,fill:W_.MUT,'text-anchor':'middle',
      'letter-spacing':'.03em',class:'fade'},lb);
  });
  S.forEach((ser,si)=>{
    const c = si===o.hero ? W_.HERO : W_.SER[Math.min(si,W_.SER.length-1)];
    el(svg,'path',{d:ser.v.map((v,i)=>`${i?'L':'M'} ${px(i)} ${py(v)}`).join(' '),
      fill:'none',stroke:c,'stroke-width':si===o.hero?2.4:1.8,'stroke-linejoin':'round',
      class:'fade',style:`animation-delay:${si*.18}s`});
    ser.v.forEach((v,i)=>{
      const d=el(svg,'circle',{cx:px(i),cy:py(v),r:si===o.hero?4.6:3.6,fill:c,class:'pop',
        style:`animation-delay:${.25+si*.18+i*.05}s`});
      tip(d,`${ser.name} · ${xs[i]} — ${o.fmt(v)}`);
    });
    const lastI=ser.v.length-1;
    txt(svg,{x:px(lastI)+12,y:py(ser.v[lastI])+4,'font-size':11,'font-weight':si===o.hero?700:600,
      fill:c,class:'fade',style:`animation-delay:${.7+si*.18}s`},ser.name);
  });
  txt(svg,{x:(LX+RX)/2,y:BY+44,'font-size':10.5,'font-weight':600,fill:W_.MUT,
    'text-anchor':'middle','letter-spacing':'.04em',class:'fade'},o.xlab||'');
  txt(svg,{x:26,y:(TY+BY)/2,'font-size':10.5,'font-weight':600,fill:W_.MUT,'text-anchor':'middle',
    'letter-spacing':'.04em',transform:`rotate(-90 26 ${(TY+BY)/2})`,class:'fade'},o.ylab||'');
  foot(svg,W,H,o.foot);
}

/* ── F11 · 刻度表盘:210° 弧,1 tick = 1% ── */
function tickGauge(svg,D,o){
  const {W,H}=box(svg), cx=W/2, cy=H*.62, R0=Math.min(H*.40,124), A0=-195, SW=210;
  const g=Math.round(D*100);
  for(let k=0;k<100;k++){
    const a=A0+k/100*SW, on=k<g;
    const len=on?16+rnd(k+1,3)*7:6+rnd(k+1,7)*3;
    const [x1,y1]=pol(cx,cy,R0,a), [x2,y2]=pol(cx,cy,R0+len,a);
    el(svg,'line',{x1,y1,x2,y2,stroke:on?W_.HERO:W_.TRACK,'stroke-width':on?1.8:1,
      class:'fade',style:`animation-delay:${k*.009}s`});
  }
  [25,50,75,100].forEach(m=>{
    const a=A0+m/100*SW, [tx,ty]=pol(cx,cy,R0-22,a);
    txt(svg,{x:tx,y:ty+3,'font-size':9,'font-weight':600,fill:W_.FAINT,'text-anchor':'middle',
      class:'fade',style:'animation-delay:.85s'},m+'%');
  });
  const num=txt(svg,{x:cx,y:cy-6,'font-size':46,'font-weight':700,fill:W_.HERO,'text-anchor':'middle',
    class:'fade',style:'animation-delay:1s'},Math.round(D*100)+'%');
  tip(num,o.note||'');
  txt(svg,{x:cx,y:cy+20,'font-size':11,'font-weight':600,fill:W_.MUT,'text-anchor':'middle',
    'letter-spacing':'.06em',class:'fade',style:'animation-delay:1.05s'},o.centerSub||'');
  foot(svg,W,H,o.foot);
}

/* ── F8 · 二维散点;靠右的点把标签翻到左侧 ── */
function plumbScatter(svg,D,o){
  const {W,H}=box(svg);
  const xs=D.map(d=>d[1]), ys=D.map(d=>d[2]);
  const xr=[Math.min(...xs,o.x0??Infinity),Math.max(...xs,o.x1??-Infinity)];
  const yr=[Math.min(...ys,0),Math.max(...ys)*1.08];
  const LX=100, RX=W-70, TY=72, BY=H-78;
  const px=v=>LX+(v-xr[0])/((xr[1]-xr[0])||1)*(RX-LX);
  const py=v=>BY-(v-yr[0])/((yr[1]-yr[0])||1)*(BY-TY);
  el(svg,'line',{x1:LX-26,y1:BY,x2:RX+24,y2:BY,stroke:W_.GRID,'stroke-width':1,class:'fade'});
  el(svg,'line',{x1:LX-26,y1:TY-14,x2:LX-26,y2:BY,stroke:W_.GRID,'stroke-width':1,class:'fade'});
  (o.vlines||[]).forEach(([v,lab])=>{
    el(svg,'line',{x1:px(v),y1:TY-14,x2:px(v),y2:BY,stroke:W_.TXT,'stroke-width':1,
      'stroke-dasharray':'5 4',opacity:.45,class:'fade'});
    txt(svg,{x:px(v),y:TY-22,'font-size':9.5,'font-weight':700,fill:W_.LAB,'text-anchor':'middle',
      'letter-spacing':'.05em',class:'fade'},lab);
  });
  D.forEach(([name,x,y,note,hi],i)=>{
    const cx=px(x), cy=py(y), flip=cx>W-260;
    el(svg,'line',{x1:cx,y1:cy,x2:cx,y2:BY,stroke:W_.TRACK,'stroke-width':.9,class:'fade',
      style:`animation-delay:${i*.07}s`});
    el(svg,'circle',{cx,cy,r:hi?8.5:5.5,fill:hi?W_.HERO:W_.DATA2,class:'fade',
      style:`animation-delay:${i*.07}s`});
    const t=txt(svg,{x:cx+(flip?-14:14),y:cy+4.5,'font-size':11,'font-weight':hi?700:600,
      fill:hi?W_.HERO:W_.LAB,'text-anchor':flip?'end':'start',class:'fade',
      style:`animation-delay:${.22+i*.07}s`},name);
    tip(t,note||name);
  });
  txt(svg,{x:(LX+RX)/2,y:BY+42,'font-size':10.5,'font-weight':600,fill:W_.MUT,
    'text-anchor':'middle','letter-spacing':'.04em',class:'fade'},o.xlab);
  txt(svg,{x:26,y:(TY+BY)/2,'font-size':10.5,'font-weight':600,fill:W_.MUT,'text-anchor':'middle',
    'letter-spacing':'.04em',transform:`rotate(-90 26 ${(TY+BY)/2})`,class:'fade'},o.ylab);
  foot(svg,W,H,o.foot);
}

const RENDER={chunkyBars,chunkyRows,pairedBars,divergingBar,tallyRows,
              tickDonut,dumbbell,hairlineLine,tickGauge,plumbScatter};
"""


PAGE_CSS = """
  :root{--bg:#F0F0EE;--ink:#1F1E1C;--muted:rgba(31,30,28,.60);--faint:rgba(31,30,28,.32);
    --grid:rgba(31,30,28,.16);--hero:#F5572F}
  body{padding:0;background:var(--bg);color:var(--ink)}
  .wrap{max-width:1180px;margin:0 auto;padding:56px 40px 80px}
  .head{border-bottom:1px solid var(--grid);padding-bottom:26px;margin-bottom:6px}
  .kicker{font-size:9.5px;font-weight:600;letter-spacing:.16em;color:var(--faint);
    text-transform:uppercase;margin-bottom:14px}
  h1{font-size:31px;font-weight:700;letter-spacing:-.025em;line-height:1.18;max-width:24em}
  .lead{font-size:14px;line-height:1.72;color:#4A4944;max-width:46em;margin-top:16px}
  .tabs{display:flex;flex-wrap:wrap;gap:2px;margin:30px 0 0;
    border-bottom:1px solid var(--grid);padding-bottom:0}
  .tab{appearance:none;border:0;background:none;cursor:pointer;font-family:inherit;
    font-size:11.5px;font-weight:600;letter-spacing:.02em;color:var(--muted);
    padding:11px 15px 12px;border-bottom:2px solid transparent;white-space:nowrap;
    transition:color .18s,border-color .18s}
  .tab:hover{color:#4A4944}
  .tab[aria-selected="true"]{color:var(--hero);border-bottom-color:var(--hero)}
  .tab .n{font-weight:800;margin-right:6px;color:var(--faint)}
  .tab[aria-selected="true"] .n{color:var(--hero)}
  .panel{display:none;padding-top:34px}
  .panel.on{display:block}
  .ptop{display:flex;align-items:flex-start;justify-content:space-between;gap:26px;
    flex-wrap:wrap;margin-bottom:22px}
  .ptop h2{font-size:23px;letter-spacing:-.02em;margin:0}
  .badge{font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
    padding:6px 13px;border-radius:99px;white-space:nowrap;flex-shrink:0}
  .meta{display:grid;grid-template-columns:1fr;gap:26px;margin-bottom:34px}
  
  .box h3{font-size:9.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--faint);margin-bottom:9px}
  .box p,.box li{font-size:13.4px;line-height:1.74;color:#4A4944;max-width:64em}
  .box ol,.box ul{padding-left:1.15em}
  .box li{margin-bottom:5px}
  .charts{display:grid;grid-template-columns:1fr;gap:26px;margin-bottom:8px}
  .charts .card{padding:28px 30px 20px;background:#E9E8E5;border-radius:20px}

  .charts svg{width:100%;height:auto;display:block}
  .concl{margin-top:30px;border-top:1px solid var(--grid);padding-top:24px}
  .concl h3{font-size:9.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--faint);margin-bottom:14px}
  .concl ol{list-style:none;padding:0;counter-reset:c}
  .concl li{counter-increment:c;position:relative;padding-left:34px;margin-bottom:13px;
    font-size:13.4px;line-height:1.66;color:var(--ink)}
  .concl li::before{content:counter(c);position:absolute;left:0;top:1px;font-size:10px;
    font-weight:800;color:var(--bg);background:var(--hero);width:19px;height:19px;
    border-radius:99px;display:grid;place-items:center;letter-spacing:0}
  .concl li b{font-weight:700}
  .next{margin-top:26px;background:#E8E7E2;border-radius:16px;padding:20px 22px}
  .next h3{color:#6A6963}
  .empty{border:1px dashed var(--grid);border-radius:16px;padding:38px;text-align:center;
    color:var(--faint);font-size:12.5px}
  .gloss{margin-top:22px}
  .gloss summary{cursor:pointer;font-size:11px;font-weight:700;letter-spacing:.12em;
    text-transform:uppercase;color:var(--faint);list-style:none;padding:8px 0}
  .gloss summary::-webkit-details-marker{display:none}
  .gloss summary::before{content:"＋ ";font-weight:700}
  .gloss[open] summary::before{content:"－ "}
  .gloss summary:hover{color:var(--ink)}
  .gterms{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:16px 30px;padding:14px 0 6px}
  .gterm b{display:block;font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:3px}
  .gterm span{font-size:12.5px;line-height:1.62;color:#4A4944}
  code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.92em;
    background:#E4E3DC;padding:1px 5px;border-radius:5px}
  /* 键盘焦点:.tab 用了 appearance:none;border:0,会连默认焦点环一起抹掉 */
  .tab:focus-visible{outline:2px solid var(--ink);outline-offset:-3px;border-radius:4px}
  @media (prefers-reduced-motion: reduce){
    *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;
      transition-duration:.001ms!important;scroll-behavior:auto!important}
  }
"""


def _esc(t):
    return html.escape(str(t), quote=False)


def _rich(t):
    """把 **粗体** 和 `代码` 转成标签,其余转义。"""
    import re
    t = _esc(t)
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    t = re.sub(r"`(.+?)`", r"<code>\1</code>", t)
    return t


def _inline_js(js):
    """内联进 <script> 前必须转义 </script>。

    ⚠️ mono-tokens.js 的头部注释里就有一句 `<script src="mono-tokens.js"></script>`,
    直接内联会让 HTML 解析器在那里【提前结束脚本块】,MONO 只剩 5 行,页面白屏,
    而且控制台只报一个含糊的 "MONO is not defined"。JSON 字符串里同理。
    """
    return js.replace("</script", "<\\/script")


def build(title, kicker, lead, steps, out, short_title=None, glossary=None):
    tokens = _inline_js(open(os.path.join(SKILL, "mono-tokens.js"), encoding="utf-8").read())
    tabs, panels, boot = [], [], []
    for i, st in enumerate(steps):
        lab, bg, fg = STATUS_STYLE[st["status"]]
        tabs.append(
            f'<button class="tab" role="tab" aria-selected="{"true" if i==0 else "false"}" '
            f'data-i="{i}"><span class="n">{i+1}</span>{_esc(st["name"])}</button>')
        cards = []
        for j, ch in enumerate(st.get("charts", [])):
            cid = f"c{i}_{j}"
            cls = "card full" if ch.get("full") else "card"
            cards.append(
                f'<div class="{cls}"><h2>{_rich(ch["title"])}</h2>'
                f'<div class="sub">{_rich(ch["sub"])}</div>'
                f'<svg id="{cid}" viewBox="0 0 820 {ch.get("h",360)}"></svg>'
                f'<div class="src">{_esc(ch["src"])}</div></div>')
            boot.append({"id": cid, "type": ch["type"], "data": ch["data"],
                         "opt": ch["opt"]})
        chart_html = (f'<div class="charts">{"".join(cards)}</div>' if cards
                      else '<div class="empty">尚无结果 —— 本步骤未开始或在等待前序步骤</div>')
        cl = "".join(f"<li>{_rich(c)}</li>" for c in st.get("conclusions", []))
        concl = (f'<div class="concl"><h3>结论</h3><ol>{cl}</ol></div>' if cl else "")
        panels.append(f"""
<section class="panel{' on' if i==0 else ''}" role="tabpanel" data-i="{i}">
  <div class="ptop"><h2>{_esc(st['name'])}</h2>
    <span class="badge" style="background:{bg};color:{fg}">{lab}{_esc(st.get('status_note',''))}</span></div>
  <div class="meta">
    <div class="box"><h3>目的与阶段</h3><p>{_rich(st['purpose'])}</p></div>
    <div class="box"><h3>实施方案</h3><ol>{''.join(f'<li>{_rich(x)}</li>' for x in st['plan'])}</ol></div>
  </div>
  {chart_html}
  {concl}
  <div class="next box"><h3>下一步</h3><p>{_rich(st['next'])}</p></div>
</section>""")

    gloss_html = ""
    if glossary:
        gt = "".join(f'<div class="gterm"><b>{_esc(t)}</b><span>{_rich(d)}</span></div>'
                     for t, d in glossary)
        gloss_html = ('<details class="gloss"><summary>先看这个:本页会用到的名词</summary>'
                      f'<div class="gterms">{gt}</div></details>')
    doc = f"""<!doctype html>
<html lang="zh"><head><meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{_esc(short_title or title)}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style id="tok"></style><style>{PAGE_CSS}</style>
</head><body>
<div class="wrap">
  <div class="head">
    <div class="kicker">{_esc(kicker)}</div>
    <h1>{_esc(title)}</h1>
    <p class="lead">{_rich(lead)}</p>
    {gloss_html}
  </div>
  <div class="tabs" role="tablist">{''.join(tabs)}</div>
  {''.join(panels)}
</div>
<script>{tokens}</script>
<script>document.getElementById('tok').textContent = MONO.CARD_CSS
  .replace(/#F0EFEB/g,'#F0F0EE').replace(/#1C1C1A/g,'#1F1E1C');</script>
<script>{_inline_js(CHART_JS)}</script>
<script>
const BOOT = {_inline_js(json.dumps(boot, ensure_ascii=False))};
const FMT = {{
  f1: v => v.toFixed(1), f2: v => v.toFixed(2), f3: v => v.toFixed(3), f4: v => v.toFixed(4),
  int: v => String(Math.round(v)),
  int1k: v => (v>=1000 ? (v/1000).toFixed(1)+'k' : String(Math.round(v))),
  deg: v => v.toFixed(2), pct: v => Math.round(v)+'%'
}};
const drawn = new Set();
function draw(i){{
  BOOT.forEach(b => {{
    if(drawn.has(b.id)) return;
    const svg = document.getElementById(b.id);
    if(!svg || !svg.closest('.panel').classList.contains('on')) return;
    drawn.add(b.id);
    const opt = Object.assign({{}}, b.opt, {{fmt: FMT[b.opt.fmt] || FMT.f3}});
    RENDER[b.type](svg, b.data, opt);
  }});
}}
const tabs=[...document.querySelectorAll('.tab')], panels=[...document.querySelectorAll('.panel')];
tabs.forEach(t => t.addEventListener('click', () => {{
  const i = +t.dataset.i;
  tabs.forEach(x => x.setAttribute('aria-selected', x === t ? 'true' : 'false'));
  panels.forEach(p => p.classList.toggle('on', +p.dataset.i === i));
  window.scrollTo({{top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'}});
  requestAnimationFrame(() => draw(i));
}}));
draw(0);
</script>
</body></html>"""
    with open(out, "w", encoding="utf-8") as f:
        f.write(doc)
    return out
